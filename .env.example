# Copy to .env and fill in. Never commit .env.
# Database password (any long random string)
POSTGRES_PASSWORD=change-me-long-random
# Token signing secret, 32+ characters:  openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-characters-long-random
# Load demo accounts + synthetic data on first start
SEED_DEMO=true
# Password for all demo accounts (leave empty to generate one per account, printed once in the logs)
SEED_USER_PASSWORD=
# "true" for one start to give all demo accounts SEED_USER_PASSWORD (if the first passwords were lost)
RESET_DEMO_PASSWORDS=false
# If the app is hosted elsewhere (e.g. GitHub Pages), its origin, e.g. https://<user>.github.io
ALLOWED_ORIGINS=
# Set to true behind a reverse proxy / load balancer (Render, Railway, nginx)
TRUST_PROXY=false
PORT=8080
